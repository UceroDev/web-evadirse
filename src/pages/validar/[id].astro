---
export const prerender = false;

import { env } from "cloudflare:workers";
import Layout from "../../layouts/Base.astro";
import {
  getEntrada,
  marcarComoUsada,
  getContador,
  incrementarContador,
} from "../../lib/entradas";
import bgImagen from "../../assets/img/eventos-imagen-2.webp";

const { id } = Astro.params;

if (!id) {
  return new Response("No encontrado", { status: 404 });
}

const kv = env.ENTRADAS_QR;
const pinCorrecto = env.PIN_VALIDACION;
const TOTAL_ENTRADAS = 50;

let error = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const pinIntroducido = formData.get("pin");

  if (pinIntroducido === pinCorrecto) {
    const entrada = await getEntrada(kv, id);

    if (entrada && !entrada.usada) {
      await marcarComoUsada(kv, id, entrada);
      await incrementarContador(kv);
    }

    return Astro.redirect(`/validar/${id}?marcado=1`);
  }

  error = "PIN incorrecto";
}

const entrada = await getEntrada(kv, id);
const reciénMarcada = Astro.url.searchParams.get("marcado") === "1";
const contador = await getContador(kv);
---

<Layout title="Validar entrada">
  <div
    style={{ backgroundImage: `url(${bgImagen.src})` }}
    class="absolute inset-0 bg-cover bg-center bg-no-repeat will-change-transform flex items-center justify-center p-4"
  >
    <div
      class="relative z-10 bg-white/30 backdrop-blur-md p-6 rounded-xl text-center"
    >
      {
        !entrada && (
          <p class="text-3xl font-anton text-red-600 [-webkit-text-stroke:1px_black]">
            Entrada no encontrada
          </p>
        )
      }

      {
        entrada?.usada && reciénMarcada && (
          <p class="text-3xl font-anton text-green-500 [-webkit-text-stroke:1px_black]">
            ✅ Entrada marcada como usada
          </p>
        )
      }

      {
        entrada?.usada && !reciénMarcada && (
          <p class="text-3xl font-anton text-yellow-400 [-webkit-text-stroke:1px_black]">
            ⚠️ Esta entrada ya ha sido usada
          </p>
        )
      }

      {
        entrada && !entrada.usada && (
          <>
            <p class="text-4xl font-anton text-green-500 mb-6 [-webkit-text-stroke:1px_black]">
              Entrada válida
            </p>

            {error && <p class="text-red-600">{error}</p>}

            <form method="POST">
              <input
                type="password"
                name="pin"
                placeholder="PIN"
                required
                autofocus
                class="bg-white p-2 rounded-2xl"
              />
              <button
                type="submit"
                class="bg-red-600 text-white font-bold py-2 px-4 border-b-4 border-red-800 rounded m-4"
              >
                Marcar como usada
              </button>
            </form>

            <p class="text-red-700 mb-2">
              Al marcar una entrada como usada esta no se puede volver a
              utilizar.
            </p>
            <p class="text-red-700">Esta acción NO se puede deshacer.</p>
          </>
        )
      }

      <p
        class="text-xl font-bold text-white mt-4 [-webkit-text-stroke:1px_black]"
      >
        {contador}/{TOTAL_ENTRADAS}
      </p>
    </div>
  </div>
</Layout>
