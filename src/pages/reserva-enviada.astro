---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
---

<Base title="EVADIRSE | Reserva enviada">
  <div class="relative z-10" data-hero-header>
    <Header />
  </div>

  <section
    class="flex min-h-screen flex-col items-center justify-center gap-6 px-4 py-12 text-center text-white"
  >
    <h1 class="font-anton text-4xl sm:text-5xl">Reserva enviada</h1>
    <p class="max-w-xl text-lg leading-relaxed sm:text-2xl">
      Nos pondremos en contacto contigo en cuanto tengamos el merch listo.
      ¡Muchas gracias por el apoyo!
    </p>

    <a href="/" class="text-white mt-24 underline">Volver a la página principal</a>
  </section>
</Base>
