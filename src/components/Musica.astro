---
import { socialLinks } from "../data/navLinks";
import { covers } from "../data/covers";

const spotifyIcon = socialLinks.find((link) => link.name === "Spotify")?.icon;
const youtubeIcon = socialLinks.find((link) => link.name === "YouTube")?.icon;
---

<section
  id="musica"
  class="mt-12 flex flex-col items-center bg-[#171717] sm:mt-36"
>
  <h2 class="font-anton text-2xl text-white sm:text-5xl mb-6">
    Otros temas
  </h2>
  <div class="flex w-full flex-wrap justify-center gap-8 px-6">
    {
      covers.map((cover) => (
        <figure class="flex w-60 flex-col items-center gap-3 text-center text-white">
          <img
            class="aspect-square w-full object-cover"
            src={cover.image.src}
            alt={cover.alt}
          />
          <figcaption class="flex flex-col items-center gap-2">
            <span class="font-black uppercase leading-tight">{cover.title}</span>
            <div class="flex items-center justify-center gap-4">
              {spotifyIcon && (
                <a
                  href={cover.spotifyLink}
                  aria-label={`Escuchar ${cover.title} en Spotify`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-8 w-8 items-center justify-center transition hover:scale-110"
                >
                  <span
                    class="block h-full w-full [&>svg]:h-full [&>svg]:w-full"
                    set:html={spotifyIcon}
                  />
                </a>
              )}

              {youtubeIcon && (
                <a
                  href={cover.youtubeLink}
                  aria-label={`Ver ${cover.title} en YouTube`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-8 w-8 items-center justify-center transition hover:scale-110"
                >
                  <span
                    class="block h-full w-full [&>svg]:h-full [&>svg]:w-full"
                    set:html={youtubeIcon}
                  />
                </a>
              )}
            </div>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
