---
import contactImage from "../assets/img/contact-image.webp";

---

<section class="relative mt-24 flex min-h-96 items-center justify-center overflow-hidden px-6 sm:mt-36 sm:min-h-144">
  <!-- Degradado superior -->
  <div
    class="absolute inset-x-0 top-0 z-10 h-48 bg-linear-to-b from-[#171717] to-transparent"
  >
  </div>

  <!-- Degradado inferior -->
  <div
    class="absolute inset-x-0 bottom-0 z-10 h-48 bg-linear-to-t from-[#171717] to-transparent"
  >
  </div>

  <!-- Imagen de fondo -->
  <div
    class="absolute -inset-6 z-0 bg-top bg-cover bg-no-repeat opacity-10"
    style={`background-image: url(${contactImage.src});`}
    data-hero-bg
  >
  </div>

  <div class="relative z-10 w-full max-w-3xl text-center font-anton text-white">
    <h2 class="text-4xl sm:whitespace-nowrap sm:text-5xl md:text-6xl">
      <span class="block sm:inline">Ponte en contacto</span>
      <span class="block sm:inline">con nosotros:</span>
    </h2>
    <p class="mt-6 text-xl sm:text-3xl">evadirsegrupo@gmail.com</p>
  </div>
</section>
