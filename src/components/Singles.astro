---
import vivirLentoCover from "../assets/img/vivir-lento.webp";
import polillaLunaCover from "../assets/img/polilla-luna.webp";
---

<section class="px-4 py-12 sm:py-16">
  <article class="mx-auto flex max-w-6xl flex-col items-center">
    <p class="text-center font-anton text-3xl text-white sm:text-5xl">
      Polilla Luna - Videoclip
    </p>

  <article class="mx-auto mt-8 w-full max-w-6xl sm:mt-8">
    <iframe
      class="mx-auto block aspect-video w-full max-w-6xl rounded-lg"
      src={`https://www.youtube.com/embed/H9RlcLeFExk?si=ZOoKnIi-L3qyEioP`}
      title="Evadirse - Polilla Luna ft. Aaron Romero"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen></iframe>
  </article>

  <p class=" mt-10 text-center font-anton text-3xl text-white sm:text-5xl">
      Cenizas - Live Session
    </p>
  <article class="mx-auto mt-8 w-full max-w-6xl sm:mt-8">
    <iframe
      class="mx-auto block aspect-video w-full max-w-6xl rounded-lg"
      src={`https://www.youtube.com/embed/n8TB0WCc6jc?si=myBAicLQuWPXRLlA`}
      title="Evadirse - Polilla Luna ft. Aaron Romero"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen></iframe>
  </article>
</section>
