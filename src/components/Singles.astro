---
import vivirLentoCover from "../assets/img/vivir-lento.webp";
import polillaLunaCover from "../assets/img/polilla-luna.webp";
---

<section class="px-4 py-12 sm:py-16">
  <article class="mx-auto flex max-w-6xl flex-col items-center">
    <p class="mb-6 text-center font-anton text-2xl text-white sm:mb-8 sm:text-3xl">
      Adelantos del disco
    </p>

    <div class="grid w-full grid-cols-1 justify-items-center gap-12 md:grid-cols-2 md:gap-16 lg:gap-24">
      <div class="flex flex-col items-center">
        <img
          src={vivirLentoCover.src}
          alt="Portada del single Vivir Lento de Evadirse"
          class="w-full max-w-80 sm:max-w-96"
        />
        <div class="mt-4 flex gap-5">
          <a
            href="https://open.spotify.com/intl-es/album/7kTlUeIfknFGIw63sGREbj"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Escuchar Vivir Lento en Spotify"
          >
            <svg
              class="flex h-8 w-8 items-center justify-center text-white transition hover:scale-110 hover:text-zinc-300"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 512 512"
              aria-hidden="true"
              fill="currentColor"
              ><path
                d="M256 8a248 248 0 1 0 0 496 248 248 0 1 0 0-496zM356.7 372.9c-4.2 0-6.8-1.3-10.7-3.6-62.4-37.6-135-39.2-206.7-24.5-3.9 1-9 2.6-11.9 2.6-9.7 0-15.8-7.7-15.8-15.8 0-10.3 6.1-15.2 13.6-16.8 81.9-18.1 165.6-16.5 237 26.2 6.1 3.9 9.7 7.4 9.7 16.5s-7.1 15.4-15.2 15.4zm26.9-65.6c-5.2 0-8.7-2.3-12.3-4.2-62.5-37-155.7-51.9-238.6-29.4-4.8 1.3-7.4 2.6-11.9 2.6-10.7 0-19.4-8.7-19.4-19.4s5.2-17.8 15.5-20.7c27.8-7.8 56.2-13.6 97.8-13.6 64.9 0 127.6 16.1 177 45.5 8.1 4.8 11.3 11 11.3 19.7-.1 10.8-8.5 19.5-19.4 19.5zm31-76.2c-5.2 0-8.4-1.3-12.9-3.9-71.2-42.5-198.5-52.7-280.9-29.7-3.6 1-8.1 2.6-12.9 2.6-13.2 0-23.3-10.3-23.3-23.6 0-13.6 8.4-21.3 17.4-23.9 35.2-10.3 74.6-15.2 117.5-15.2 73 0 149.5 15.2 205.4 47.8 7.8 4.5 12.9 10.7 12.9 22.6 0 13.6-11 23.3-23.2 23.3z"
              ></path></svg
            >
          </a>
          <a
            href="https://youtu.be/THBcWbFyqOg"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver Vivir Lento en YouTube"
          >
            <svg
              class="flex h-8 w-8 items-center justify-center text-white transition hover:scale-110 hover:text-zinc-300"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 576 512"
              aria-hidden="true"
              fill="currentColor"
              ><path
                d="M549.7 124.1C543.5 100.4 524.9 81.8 501.4 75.5 458.9 64 288.1 64 288.1 64S117.3 64 74.7 75.5C51.2 81.8 32.7 100.4 26.4 124.1 15 167 15 256.4 15 256.4s0 89.4 11.4 132.3c6.3 23.6 24.8 41.5 48.3 47.8 42.6 11.5 213.4 11.5 213.4 11.5s170.8 0 213.4-11.5c23.5-6.3 42-24.2 48.3-47.8 11.4-42.9 11.4-132.3 11.4-132.3s0-89.4-11.4-132.3zM232.2 337.6V175.2l142.7 81.2-142.7 81.2z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <div class="flex flex-col items-center">
        <img
          src={polillaLunaCover.src}
          alt="Portada del single Polilla Luna de Evadirse"
          class="w-full max-w-80 sm:max-w-96"
        />
        <div class="mt-4 flex gap-5">
          <a
            href="https://open.spotify.com/intl-es/album/4gtAo51khA1wC8BQV92VMi"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Escuchar Polilla Luna en Spotify"
          >
            <svg
              class="flex h-8 w-8 items-center justify-center text-white transition hover:scale-110 hover:text-zinc-300"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 512 512"
              aria-hidden="true"
              fill="currentColor"
              ><path
                d="M256 8a248 248 0 1 0 0 496 248 248 0 1 0 0-496zM356.7 372.9c-4.2 0-6.8-1.3-10.7-3.6-62.4-37.6-135-39.2-206.7-24.5-3.9 1-9 2.6-11.9 2.6-9.7 0-15.8-7.7-15.8-15.8 0-10.3 6.1-15.2 13.6-16.8 81.9-18.1 165.6-16.5 237 26.2 6.1 3.9 9.7 7.4 9.7 16.5s-7.1 15.4-15.2 15.4zm26.9-65.6c-5.2 0-8.7-2.3-12.3-4.2-62.5-37-155.7-51.9-238.6-29.4-4.8 1.3-7.4 2.6-11.9 2.6-10.7 0-19.4-8.7-19.4-19.4s5.2-17.8 15.5-20.7c27.8-7.8 56.2-13.6 97.8-13.6 64.9 0 127.6 16.1 177 45.5 8.1 4.8 11.3 11 11.3 19.7-.1 10.8-8.5 19.5-19.4 19.5zm31-76.2c-5.2 0-8.4-1.3-12.9-3.9-71.2-42.5-198.5-52.7-280.9-29.7-3.6 1-8.1 2.6-12.9 2.6-13.2 0-23.3-10.3-23.3-23.6 0-13.6 8.4-21.3 17.4-23.9 35.2-10.3 74.6-15.2 117.5-15.2 73 0 149.5 15.2 205.4 47.8 7.8 4.5 12.9 10.7 12.9 22.6 0 13.6-11 23.3-23.2 23.3z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.youtube.com/watch?v=H9RlcLeFExk"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver Polilla Luna en YouTube"
          >
            <svg
              class="flex h-8 w-8 items-center justify-center text-white transition hover:scale-110 hover:text-zinc-300"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 576 512"
              aria-hidden="true"
              fill="currentColor"
              ><path
                d="M549.7 124.1C543.5 100.4 524.9 81.8 501.4 75.5 458.9 64 288.1 64 288.1 64S117.3 64 74.7 75.5C51.2 81.8 32.7 100.4 26.4 124.1 15 167 15 256.4 15 256.4s0 89.4 11.4 132.3c6.3 23.6 24.8 41.5 48.3 47.8 42.6 11.5 213.4 11.5 213.4 11.5s170.8 0 213.4-11.5c23.5-6.3 42-24.2 48.3-47.8 11.4-42.9 11.4-132.3 11.4-132.3s0-89.4-11.4-132.3zM232.2 337.6V175.2l142.7 81.2-142.7 81.2z"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>
  </article>

  <article class="mx-auto mt-12 w-full max-w-6xl sm:mt-16">
    <iframe
      class="mx-auto block aspect-video w-full max-w-6xl rounded-lg"
      src={`https://www.youtube.com/embed/H9RlcLeFExk?si=ZOoKnIi-L3qyEioP`}
      title="Evadirse - Polilla Luna ft. Aaron Romero"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen></iframe>
  </article>
</section>
