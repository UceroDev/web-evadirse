---
import logo from "../assets/img/logo.png";
import heroImage from "../assets/img/hero.webp";
---

<section class="relative min-h-screen overflow-hidden">
  <div class="absolute inset-0 overflow-hidden">
    <div
      class="absolute -inset-6 bg-cover bg-center bg-no-repeat"
      style={`background-image: url(${heroImage.src});`}
      data-hero-bg
    >
    </div>
  </div>
  <div class="absolute inset-0 bg-black/65" data-hero-shade></div>


  <div class="absolute inset-0 flex flex-col items-center justify-center drop-shadow-[0_12px_30px_rgba(0,0,0,0.75)]">
      <img src={logo.src} alt="Logo de Evadirse" class="w-96 mb-3 drop-shadow-[0_4px_12px_rgba(255,255,255,0.2)]" />
      <p class="text-white font-anton text-xl">Página en construcción...</p>
  </div>


</section>
