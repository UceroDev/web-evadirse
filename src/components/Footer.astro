---

import logo from "../assets/img/logo.png";
---



<footer class=" px-6 py-8 mt-44 text-center text-white">
  <a href="/" class="inline-block transition-opacity hover:opacity-75">
    <img src={logo.src} alt="Logo Evadirse" class="mx-auto w-28" />
  </a>

  <p>© Todos los derechos reservados</p>
</footer>

<button
  type="button"
  id="scroll-to-top"
  aria-label="Volver arriba"
  class="fixed bottom-5 right-5 z-50 hidden h-11 w-11 items-center justify-center rounded-full border border-white/40 bg-[#171717]/90 text-xl text-white shadow-lg transition hover:border-white hover:bg-white hover:text-[#171717]"
>
  &#8593;
</button>

<script>
  const scrollToTop = document.querySelector<HTMLButtonElement>("#scroll-to-top");

  if (scrollToTop) {
    const toggleScrollButton = () => {
      scrollToTop.classList.toggle("hidden", window.scrollY < 400);
      scrollToTop.classList.toggle("flex", window.scrollY >= 400);
    };

    window.addEventListener("scroll", toggleScrollButton, { passive: true });
    toggleScrollButton();

    scrollToTop.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
</script>
