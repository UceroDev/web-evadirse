---
import Header from "../components/Header.astro";
import heroImage from "../assets/img/hero.webp";
import SocialLinks from "../components/SocialLinks.astro";
//import heroVideo from "../assets/video-hero.mp4";
---

<section class="relative min-h-screen overflow-hidden">
  <div class="absolute inset-0 overflow-hidden">
    <div
      class="absolute -inset-6 bg-cover bg-center bg-no-repeat"
      style={`background-image: url(${heroImage.src});`}
      data-hero-bg
    ></div>
  </div>

  <div class="absolute inset-0 bg-black/50" data-hero-shade></div>

  <div
    class="absolute inset-0 opacity-0 mix-blend-overlay bg-[repeating-linear-gradient(0deg,rgba(255,255,255,0.12)_0px,rgba(255,255,255,0.12)_1px,transparent_1px,transparent_6px)]"
    data-hero-noise
  >
  </div>

  <div
    class="absolute inset-x-0 bottom-0 z-1 h-48 bg-linear-to-t from-[#171717] via-[#171717]/70 to-transparent md:h-64"
  >
  </div>

  <div class="relative z-10" data-hero-header>
    <Header />
  </div>

  <div
    class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2"
    data-hero-social
  >
    <SocialLinks />
  </div>
</section>
