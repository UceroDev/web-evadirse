---
import merchBg1 from "../assets/img/portada-disco-negro.jpeg";
import merchBg2 from "../assets/img/fm-terrassa.webp";
import blackTFront from "../assets/img/camiseta-negra-delante.png";
import blackTBack from "../assets/img/camiseta-negra-detras.png";
import whiteTFront from "../assets/img/camiseta-blanca-delante.png";
import whiteTBack from "../assets/img/camiseta-blanca-detras.png";
import cd from "../assets/img/cd.png";
---

<section id="merch" class="relative overflow-hidden">
  <!-- Degradado superior -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-10 h-72 bg-linear-to-b from-[#171717] to-transparent sm:h-96 md:h-300"
  >
  </div>

  <div
    class="relative h-72 overflow-hidden bg-cover bg-position-[center_85%] sm:h-160 md:h-200"
    style={`background-image: url(${merchBg1.src});`}
  >
    <div
      class="relative z-10 flex h-full items-center justify-center gap-0 sm:gap-4 md:gap-8"
    >
      <img
        src={blackTFront.src}
        alt="Camiseta negra del disco Vivir Lento de Evadirse"
        class="w-[44vw] max-w-72 object-contain sm:w-64 md:w-auto md:max-w-none"
      />
      <img
        src={blackTBack.src}
        alt="Camiseta negra del disco Vivir Lento de Evadirse"
        class="w-[44vw] max-w-72 object-contain sm:w-64 md:w-auto md:max-w-none"
      />

      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-32 bg-linear-to-b from-transparent via-[#171717]/70 to-[#171717] sm:h-40 md:hidden"
      ></div>
    </div>
  </div>

  <div
    class="relative min-h-264 overflow-hidden bg-cover bg-position-[center_85%] md:h-400"
    style={`background-image: url(${merchBg2.src});`}
  >
    <div class="absolute inset-0 bg-black/70" data-hero-shade></div>

    <!-- Degradado entre ambas secciones -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-11 h-56 bg-linear-to-b from-[#171717] via-[#0a0a0a]/80 to-transparent sm:h-72 md:h-200 md:from-[#0a0a0a] md:via-transparent"
    >
    </div>

    <p
      class="relative z-12 px-4 text-center font-anton text-3xl leading-tight text-white sm:text-4xl md:pt-0 md:text-5xl"
    >
      Reserva tu camiseta · 14€
    </p>

    <div
      class="relative z-12 mt-12 flex items-center justify-center gap-0 sm:gap-4 md:mt-28 md:gap-8"
    >
      <img
        src={whiteTFront.src}
        alt="Camiseta blanca del disco Vivir Lento de Evadirse"
        class="w-[44vw] max-w-72 object-contain sm:w-64 md:w-auto md:max-w-none"
      />
      <img
        src={whiteTBack.src}
        alt="Camiseta blanca del disco Vivir Lento de Evadirse"
        class="w-[44vw] max-w-72 object-contain sm:w-64 md:w-auto md:max-w-none"
      />
    </div>

    <div
      class="relative z-12 mt-16 flex flex-col items-center justify-center gap-16 px-4 pb-28 sm:mt-24 sm:gap-24 md:mt-32 md:flex-row md:gap-11"
    >
      <div class="order-2 flex w-full max-w-md flex-col items-center md:order-1">
        <p
          class="text-center font-anton text-3xl leading-tight text-white sm:text-4xl md:text-5xl"
        >
          Camiseta + CD · 20€
        </p>
        <a
          href="/reservarMerch"
          class="mt-6 block w-full max-w-34 rounded-3xl bg-white px-5 py-4 text-center text-lg text-black shadow-[8px_8px_0_#555] transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-[4px_4px_0_#555] sm:text-xl"
        >
          RESERVAR
        </a>
      </div>
      <div class="order-1 flex w-full max-w-md flex-col items-center md:order-2">
        <p class="mb-4 text-center font-anton text-3xl leading-tight text-white sm:text-4xl md:text-5xl">
          Reserva tu CD · 10€
        </p>
        <img
          src={cd.src}
          alt="Imagen del CD de Vivir Lento de Evadirse"
          class="w-full max-w-72 object-contain sm:max-w-96 md:w-130"
        />
      </div>
    </div>
  </div>

  <div
    class="absolute inset-x-0 bottom-0 z-10 h-48 bg-linear-to-t from-[#171717] to-transparent"
  >
  </div>
</section>
