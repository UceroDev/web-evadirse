---
import eventsImage from "../assets/img/eventos-imagen.webp";
import { events } from "../data/events";
---

<section id="eventos" class="relative overflow-hidden">

  <div
    class="absolute inset-x-0 top-0 z-10 h-48 bg-linear-to-b from-[#171717] to-transparent"
  ></div>

  <div
    class="absolute inset-x-0 bottom-0 z-10 h-48 bg-linear-to-t from-[#171717] to-transparent"
  ></div>

  <div
    class="absolute -inset-150 bg-cover bg-center bg-no-repeat will-change-transform"
    style={`background-image: url(${eventsImage.src});`}
    data-hero-bg
  ></div>

  <div class="absolute inset-0 bg-black/75" data-hero-shade></div>

  <div
    class="relative z-10 flex min-h-screen flex-col items-center justify-center px-6"
  >
    <div class="mb-12 text-center">
      <h2 class="font-anton text-5xl text-white sm:text-6xl lg:text-7xl">
        PRÓXIMOS EVENTOS
      </h2>
    </div>

    <div class="mx-auto w-full max-w-4xl">
      <div class="divide-y divide-white/10">
        {events.map(({ date, name, location, ticketUrl }) => (
          <div
            class="group flex items-center justify-between gap-4 rounded-sm py-5 transition-all duration-300"
          >
            <span
              class="w-36 shrink-0 text-sm font-semibold uppercase tracking-widest text-white"
            >
              {date}
            </span>

            <div class="flex-1">
              <p class="font-anton text-2xl uppercase text-white sm:text-3xl">
                {name}
              </p>
              <p class="mt-0.5 text-sm tracking-wide text-white">{location}</p>
            </div>

            {ticketUrl ? (
              <a
                href={ticketUrl}
                class="group/btn relative shrink-0 overflow-hidden rounded-full border border-white/30 px-5 py-1.5 text-xs font-semibold uppercase tracking-widest text-white transition-all duration-300 hover:border-white"
              >
                <span class="relative z-10 transition-colors duration-300 group-hover/btn:text-black">
                  Entradas
                </span>
                <span class="absolute inset-0 translate-y-full bg-white transition-transform duration-300 group-hover/btn:translate-y-0"></span>
              </a>
            ) : (
              <span class="shrink-0 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-emerald-400">
                Gratuito
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
