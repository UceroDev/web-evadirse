---
import eventsImage from "../assets/img/eventos-imagen.webp";
---

<section id="eventos" class="relative min-h-screen overflow-hidden">
  <!-- Gradient superior -->
  <div
    class="absolute inset-x-0 top-0 z-10 h-48 bg-linear-to-b from-[#171717] to-transparent"
  >
  </div>

  <!-- Gradient inferior -->
  <div
    class="absolute inset-x-0 bottom-0 z-10 h-48 bg-linear-to-t from-[#171717] to-transparent"
  >
  </div>

  <div
    class="absolute -inset-6 bg-cover bg-center bg-no-repeat will-change-transform"
    style={`background-image: url(${eventsImage.src});`}
    data-hero-bg
  >
  </div>

  <div class="absolute inset-0 bg-black/50" data-hero-shade></div>

  <div
    class="relative z-10 flex min-h-screen flex-col items-center justify-center"
  >
    <h2 class="text-white flex justify-center text-6xl m-8 font-anton">
      PRÓXIMOS EVENTOS
    </h2>

    <div class="mx-auto w-full max-w-5xl overflow-x-auto px-6 text-white">
      <table
        class="w-full min-w-2xl border-collapse text-left text-sm uppercase tracking-wide sm:text-base"
      >
        <tbody>
          <tr>
            <td class="py-5 pr-6 font-semibold text-2xl">2 de junio</td>
            <td class="px-6 py-5 text-2xl">Razzmatazz</td>
            <td class="px-6 py-5 text-2xl">Barcelona</td>
            <td class="py-5 pl-6 underline text-2xl">Gratuito</td>
          </tr>
          <tr>
            <td class="py-5 pr-6 font-semibold text-2xl">20 de junio</td>
            <td class="px-6 py-5 text-2xl">------</td>
            <td class="px-6 py-5 text-2xl">------</td>
            <td class="py-5 pl-6 underline text-2xl">Gratuito</td>
          </tr>
          <tr>
            <td class="py-5 pr-6 font-semibold text-2xl">5 de julio</td>
            <td class="px-6 py-5 text-2xl">Festa Major</td>
            <td class="px-6 py-5 text-2xl">Terrassa</td>
            <td class="py-5 pl-6 underline text-2xl">Gratuito</td>
          </tr>
          <tr>
            <td class="py-5 pr-6 font-semibold text-2xl">10 de octubre</td>
            <td class="px-6 py-5 text-2xl">Sala Rasa 64</td>
            <td class="px-6 py-5 text-2xl">Terrassa</td>
            <td class="py-5 pl-6 text-2xl">Entradas</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
