---
import newAlbumImage from "../assets/img/portada-disco-negro.jpeg";
import bandCampLogo from "../assets/svg/Bandcamp-logotype-light.svg";
import amazonMusicLogo from "../assets/img/Amazon_Music_White.png";
---

<section id="new-album" class="relative min-h-168 overflow-hidden md:min-h-144">
  <!-- Degradado superior -->
  <div
    class="absolute inset-x-0 top-0 z-10 h-48 bg-linear-to-b from-[#171717] to-transparent"
  >
  </div>

  <!-- Degradado inferior -->
  <div
    class="absolute inset-x-0 bottom-0 z-10 h-48 bg-linear-to-t from-[#171717] to-transparent"
  >
  </div>

  <!-- Imagen de fondo -->
  <div
    class="absolute -inset-6 z-0 bg-top bg-cover bg-no-repeat opacity-10"
    style={`background-image: url(${newAlbumImage.src});`}
    data-hero-bg
  >
  </div>

  <div
    class="relative z-20 flex flex-col items-center gap-5 px-6 pt-20 pb-5 text-center md:px-10 md:py-16"
  >
    <div class="max-w-xl font-anton text-white">
      <h2 class="text-5xl leading-[0.95] sm:text-7xl md:text-8xl">
        VIVIR LENTO YA DISPONIBLE
      </h2>
    </div>

    <div class="w-full max-w-xl">
      <iframe
        src="https://open.spotify.com/embed/album/4ewQkQqMkScp5DaMEMjiFH?utm_source=generator"
        class="w-full rounded-xl"
        height="352"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        title="Vivir Lento en Spotify"></iframe>
      <p class="my-3 text-center font-semibold text-white">
        (Disponible también en el resto de plataformas de streaming)
      </p>
      
    </div>
  </div>
</section>
